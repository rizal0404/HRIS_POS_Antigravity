# ============================================================
# HRIS-POS VPS Deployment - Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# ---- Database (PostgreSQL) ----
POSTGRES_USER=hris_user
POSTGRES_PASSWORD=ganti_dengan_password_kuat
POSTGRES_DB=hris_db

# ---- API Configuration ----
PORT=3001
NODE_ENV=production

# URL Backend anda (ex: https://api.hris.domain.com)
BETTER_AUTH_URL=https://api.hris.domain.com
BETTER_AUTH_SECRET=ganti_dengan_secret_kuat_random_64_karakter

# ---- Frontend Configuration ----
# URL Frontend anda (ex: https://hris.domain.com)
FRONTEND_URL=https://hris.domain.com
VITE_API_URL=https://api.hris.domain.com

# Port untuk web container (default 80, Coolify biasanya handle via reverse proxy)
WEB_HOST_PORT=80

# ---- OAuth Providers (Optional) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ---- Telegram Configuration ----
TELEGRAM_BOT_TOKEN=ganti_dengan_token_bot_anda

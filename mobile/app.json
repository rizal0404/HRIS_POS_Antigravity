{
  "expo": {
    "name": "HRISPOS Mobile",
    "slug": "hrispos-mobile",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f172a"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.qctonasa.hris",
      "infoPlist": {
        "NSCameraUsageDescription": "Aplikasi memerlukan akses kamera untuk foto presensi",
        "NSLocationWhenInUseUsageDescription": "Aplikasi memerlukan akses lokasi untuk mencatat lokasi presensi"
      }
    },
    "android": {
      "package": "com.qctonasa.hris",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0f172a"
      },
      "permissions": [
        "CAMERA",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION"
      ]
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Izinkan $(PRODUCT_NAME) mengakses kamera untuk foto presensi"
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Izinkan $(PRODUCT_NAME) mengakses lokasi untuk mencatat presensi"
        }
      ],
      "expo-secure-store",
      "expo-build-properties"
    ],
    "extra": {
      "eas": {
        "projectId": "your-project-id"
      }
    }
  }
}